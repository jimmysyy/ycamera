{
  "name": "ycamera",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "description": "苹果极简风格的摄影作品展示静态网站。瀑布流布局，毛玻璃灯箱，响应式适配多端。",
  "scripts": {
    "dev": "python3 -m http.server 8080",
    "photos": "node scripts/process-photos.mjs",
    "photos:force": "node scripts/process-photos.mjs --force",
    "build": "node scripts/build.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jimmysyy/ycamera.git"
  },
  "devDependencies": {
    "exif-reader": "^2.0.3",
    "exifr": "^7.1.3",
    "sharp": "^0.35.5"
  }
}
